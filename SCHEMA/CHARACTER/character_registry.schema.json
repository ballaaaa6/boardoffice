{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gds_character_registry_v3",
  "title": "GDS Unified Character Identity Registry v3",
  "type": "object",
  "required": ["schema", "identity_model", "action_set", "asset_registry", "character_count", "movement_profile_contract", "characters"],
  "properties": {
    "schema": {"const": "gds_character_registry_v3"},
    "identity_model": {"const": "stable_id_plus_composition_plus_provenance"},
    "action_set": {"const": "gds_standard_v1"},
    "asset_registry": {"type": "string"},
    "character_count": {"const": 302},
    "movement_profile_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "speed_range_percent", "assignment_policy", "profile_seed", "spawn_policy"],
      "properties": {
        "schema": {"const": "gds.character_movement_profile.v1"},
        "speed_range_percent": {
          "type": "array",
          "prefixItems": [{"const": 225}, {"const": 250}],
          "minItems": 2,
          "maxItems": 2
        },
        "assignment_policy": {"const": "embedded_character_metadata"},
        "profile_seed": {"type": "string", "minLength": 1},
        "spawn_policy": {"const": "read_once_from_character_metadata"}
      }
    },
    "compatibility_fields": {"type": "array", "items": {"type": "string"}},
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "composition", "origin", "action_set", "render_canvas", "package_class", "body_asset_id", "face_asset_id", "legacy_package_path", "movement_profile"],
        "properties": {
          "character_id": {"type": "string", "minLength": 1},
          "composition": {
            "type": "object",
            "required": ["body", "face"],
            "properties": {
              "body": {"type": "string", "pattern": "^character\\.body\\.[0-9]{3}$"},
              "face": {"type": "string", "pattern": "^character\\.face\\.[0-9]{3}$"}
            },
            "additionalProperties": false
          },
          "origin": {
            "type": "object",
            "required": ["type", "collection", "source", "legacy_id"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "collection": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "legacy_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "action_set": {"const": "gds_standard_v1"},
          "render_canvas": {
            "type": "array",
            "prefixItems": [{"const": 32}, {"const": 42}],
            "minItems": 2,
            "maxItems": 2
          },
          "package_class": {"enum": ["original", "custom"]},
          "body_asset_id": {"type": "string", "pattern": "^character\\.body\\.[0-9]{3}$"},
          "face_asset_id": {"type": "string", "pattern": "^character\\.face\\.[0-9]{3}$"},
          "legacy_package_path": {"type": "string", "minLength": 1},
          "movement_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speed_percent"],
            "properties": {
              "speed_percent": {"type": "integer", "minimum": 225, "maximum": 250}
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
