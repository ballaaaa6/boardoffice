{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gds.speech_scheduler.v2",
  "title": "GDS deterministic speech scheduler contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema", "contract_id", "version", "scope", "runtime", "api",
    "categories", "work_dialogue_policy", "timing", "conversation_modes", "emotion", "lane", "actor_slots", "resource_claims", "actor_bridge",
    "assignment_policy", "render_policy", "leaving_trigger_source"
  ],
  "properties": {
    "$schema": {"const": "gds.speech_scheduler.v2"},
    "schema": {"const": "gds.speech_scheduler.v2"},
    "contract_id": {"const": "contract.gds.speech_scheduler.v2"},
    "version": {"const": "2.0.0"},
    "scope": {"const": "deterministic_actor_slot_and_conversation_trigger_scheduler"},
    "runtime": {"const": "RUNTIME/speech_scheduler_core.py"},
    "api": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "categories": {
      "type": "object", "additionalProperties": false,
        "required": ["in_work_rotation", "solo_recurring", "pair_exchange", "lifecycle_one_shot", "legacy_compatibility"],
      "properties": {
        "in_work_rotation": {"const": ["anticipation", "work_progress", "work_complete", "encouragement", "praise", "celebration", "disappointment", "fatigue", "surprise", "uncertainty", "idle_flavor"]},
        "solo_recurring": {"const": ["anticipation", "work_progress", "work_complete", "encouragement", "praise", "celebration", "disappointment", "fatigue", "surprise", "uncertainty", "idle_flavor"]},
        "pair_exchange": {"const": ["conversation_open", "conversation_reply"]},
        "lifecycle_one_shot": {
          "type": "object", "additionalProperties": false,
          "required": ["greeting", "work_start", "leaving"],
          "properties": {
            "greeting": {"$ref": "#/$defs/oneShotGreeting"},
            "work_start": {"$ref": "#/$defs/oneShot"},
            "leaving": {"$ref": "#/$defs/oneShot"}
          }
        },
        "legacy_compatibility": {
          "type": "object", "additionalProperties": false,
          "required": ["fatigue"],
          "properties": {
            "fatigue": {"const": "explicit_home_request_only"}
          }
        }
      }
    },
    "work_dialogue_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "categories", "selection", "bubble_selection", "pose_policy", "numeric_effect_policy"],
      "properties": {
        "trigger": {"const": "actor_activity_working"},
        "categories": {"const": ["anticipation", "work_progress", "work_complete", "encouragement", "praise", "celebration", "disappointment", "fatigue", "surprise", "uncertainty", "idle_flavor"]},
        "selection": {"const": "persistent_shuffle_bag_no_repeat_then_refill"},
        "bubble_selection": {"const": "smallest_allowed_fit"},
        "pose_policy": {"const": "remain_seated_at_owned_workseat"},
        "numeric_effect_policy": {"const": "none"}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["playback_tick_ms", "bubble_visible_ms", "bubble_fade_ms", "session_hold_ms", "solo_interval_seconds_range", "pair_interval_seconds_range", "retry_interval_seconds_range", "timer_semantics", "first_bubble_boundary", "no_overlap_scope", "same_session_pair_bubbles_may_overlap"],
      "properties": {
        "playback_tick_ms": {"const": 60},
        "bubble_visible_ms": {"const": 4000},
        "bubble_fade_ms": {"const": 300},
        "session_hold_ms": {"const": 4300},
        "solo_interval_seconds_range": {"const": [30, 60]},
        "pair_interval_seconds_range": {"const": [45, 75]},
        "retry_interval_seconds_range": {"const": [15, 30]},
        "timer_semantics": {"const": "work_time_only_reset_after_return_to_work"},
        "first_bubble_boundary": {"const": "conversation_talk_arrival"},
        "no_overlap_scope": {"const": "one_bubble_slot_per_actor"},
        "same_session_pair_bubbles_may_overlap": {"const": true}
      }
    },
    "conversation_modes": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "available_modes", "ceo_front", "seated_host", "standing_pair", "ceo_outbound", "unavailable_partner_fallback", "ceo_request_fallback", "cross_floor", "group_talk", "walk_and_talk"],
      "properties": {
        "selection": {"const": "uniform_among_currently_valid_modes"},
        "available_modes": {"const": ["ceo_front", "seated_host", "standing_pair"]},
        "ceo_front": {"$ref": "#/$defs/mode"},
        "seated_host": {"$ref": "#/$defs/mode"},
        "standing_pair": {"$ref": "#/$defs/mode"},
        "ceo_outbound": {"const": false},
        "unavailable_partner_fallback": {"const": "seated_self_talk"},
        "ceo_request_fallback": {"const": "seated_self_talk_no_outbound_route"},
        "cross_floor": {"const": false},
        "group_talk": {"const": false},
        "walk_and_talk": {"const": false}
      }
    },
    "emotion": {
      "type": "object", "additionalProperties": false,
      "required": ["standing_pair_only", "roll_scope", "roll_source", "even_result", "odd_result", "hold_ms", "stamina_effect", "stamina_effect_display_delta", "stamina_effect_milli_delta", "stamina_effect_owner", "return_after_emotion"],
      "properties": {
        "standing_pair_only": {"const": true},
        "roll_scope": {"const": "one_shared_roll_per_completed_standing_pair"},
        "roll_source": {"const": "persisted_scheduler_prng_state"},
        "even_result": {"const": "happy"},
        "odd_result": {"const": "sad"},
        "hold_ms": {"const": 1200},
        "stamina_effect": {"const": "actor_snapshot_numeric_delta"},
        "stamina_effect_display_delta": {
          "type": "object", "additionalProperties": false,
          "required": ["sad", "happy"],
          "properties": {"sad": {"const": -1}, "happy": {"const": 2}}
        },
        "stamina_effect_milli_delta": {
          "type": "object", "additionalProperties": false,
          "required": ["sad", "happy"],
          "properties": {"sad": {"const": -1000}, "happy": {"const": 2000}}
        },
        "stamina_effect_owner": {"const": "CentralGameCore.actor_snapshot"},
        "return_after_emotion": {"const": true}
      }
    },
    "actor_slots": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "lock_window", "pair_admission", "queue_policy"],
      "properties": {
        "scope": {"const": "one_slot_per_actor"},
        "lock_window": {"const": "active_bubble_until_fade_end"},
        "pair_admission": {"const": "atomically_claim_all_participant_slots"},
        "queue_policy": {"const": "priority_then_due_time_then_employee_id"}
      }
    },
    "resource_claims": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "admission", "release"],
      "properties": {
        "scope": {"const": "pair_only_physical_talk_spot_path_and_crowd"},
        "admission": {"const": "candidate_specific_reserved_cells"},
        "release": {"const": "session_fade_end_or_cancel"}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "lock_window", "queue_policy", "priority_order"],
      "properties": {
        "scope": {"const": "deprecated_floor_diagnostic_projection"},
        "lock_window": {"const": "not_used_for_admission"},
        "queue_policy": {"const": "priority_then_due_time_then_employee_id"},
       "priority_order": {"const": ["leaving", "fatigue", "greeting", "work_start", "conversation_open", "pair", "solo"]},
       "queue_metadata": {
         "type": "array",
         "items": {"type": "string", "minLength": 1},
         "minItems": 1
       }
      }
    },
    "actor_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "talk_behavior",
        "talk_commit",
        "reception_crossing",
        "workseat_reentry",
        "lifecycle_boundaries",
        "effective_timestamp_field"
      ],
      "properties": {
        "talk_behavior": {
          "const": "behavior_started.actor_request_to_speech_plan"
        },
        "talk_commit": {
          "const": "speech_session_plan_to_actor_start_talk_session"
        },
        "reception_crossing": {
          "const": "actor_route_sample_draws_over_reception"
        },
        "workseat_reentry": {
          "const": "workseat_reentered_to_workseat_entered"
        },
        "lifecycle_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portal_entered", "workseat_reentered", "talk_returned", "effective_timestamp"],
          "properties": {
            "portal_entered": {"const": "spawned_then_delayed_greeting"},
            "workseat_reentered": {"const": "workseat_entered_then_work_start"},
            "talk_returned": {"const": "returned_to_work_then_entry_lines"},
            "effective_timestamp": {"const": "actor_event.timestamp_ms"}
          }
        },
        "effective_timestamp_field": {
          "const": "effective_at_ms"
        },
        "unavailable_partner_fallback": {
          "const": "seated_self_talk"
        },
        "ceo_request_fallback": {
          "const": "seated_self_talk_no_outbound_route"
        }
      }
    },
    "assignment_policy": {"const": "scheduler_never_mutates_workstation_ownership"},
    "render_policy": {"const": "speech_selects_timing_and_plan; CentralGameCore_commits_actor_route_or_working_overlay"},
    "leaving_trigger_source": {"const": "CentralGameCore.actor_draws_over_reception"}
  },
  "$defs": {
    "oneShot": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "once_per_work_session": {"const": true},
        "once_per_departure": {"const": true},
        "legacy_fallback": {"type": "string", "minLength": 1}
      }
    },
    "oneShotGreeting": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "delay_seconds_range", "once_per_spawn"],
      "properties": {
        "trigger": {"const": "spawn_then_delay"},
        "delay_seconds_range": {"const": [2, 3]},
        "once_per_spawn": {"const": true}
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["initiator", "partner", "visitor_pose", "host_pose", "host_movement"],
      "properties": {
        "initiator": {"const": "employee"},
        "partner": {"type": "string", "minLength": 1},
        "visitor_pose": {"const": "idle"},
        "host_pose": {"type": "string", "minLength": 1},
        "host_movement": {"type": "string", "minLength": 1}
      }
    }
  }
}
