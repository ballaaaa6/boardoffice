{
  "$schema": "gds.runtime_presentation.v1",
  "schema": "gds.runtime_presentation.v1",
  "contract_id": "contract.gds.runtime_presentation.v1",
  "version": "1.0.0",
  "scope": "read_only_cross_channel_render_snapshot",
  "runtime": "RUNTIME/central_core.py",
  "api": ["CentralGameCore.resolve_runtime_presentation"],
  "renderer": "RUNTIME/runtime_presentation_renderer.py",
  "renderer_api": [
    "RuntimePresentationRenderer.render_runtime_snapshot",
    "RuntimePresentationRenderer.render_presentation",
    "RuntimePresentationLoop.tick",
    "RuntimePresentationLoop.render_current"
  ],
  "host_adapter": "RUNTIME/runtime_presentation_host.py",
  "host_api": [
    "RuntimePresentationHostAdapter.tick",
    "RuntimePresentationHostAdapter.render_current"
  ],
  "snapshot_schema": "SCHEMA/runtime_presentation_snapshot.schema.json",
  "source_channels": ["actor_snapshot", "speech_snapshot", "conversation_plan"],
  "ownership": {
    "actor_activity_stamina_assignment": "actor_snapshot",
    "speech_timing_bubble_lane": "speech_snapshot",
    "movement_pose_and_dialogue_track": "conversation_plan",
    "mutation": false
  },
  "timing_ms": {
    "simulation_tick": 60,
    "character_frame": 360,
    "effect_frame": 240,
    "humanball_frame": 240,
    "bubble_visible": 4000,
    "bubble_fade": 300
  },
  "render_policy": {
    "speech_and_pose_are_independent": true,
    "workseat_and_walking_are_mutually_exclusive": true,
    "seat_boundary": "presentation_only_workseat_visual_anchor_to_transition_gate_bridge",
    "seat_boundary_duration_ms": 240,
    "seat_boundary_tick_policy": "fixed_60ms_steps",
    "bubble_anchor": "direct_head_anchor",
    "bubble_paint_order": "turn_index_then_employee_id",
    "assignment_mutation": false
  },
  "emotion_policy": {
    "standing_pair_only": true,
    "outcome": "shared_d6_even_happy_odd_sad",
    "hold_ms": 1200,
    "numeric_stamina_delta": {"sad": -1, "happy": 2},
    "numeric_stamina_delta_unit": "display_stamina",
    "numeric_stamina_owner": "CentralGameCore.actor_snapshot"
  }
}
