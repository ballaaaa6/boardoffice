{
  "$schema": "gds.actor_simulation.v1",
  "schema": "gds.actor_simulation.v1",
  "contract_id": "contract.gds.actor_simulation.v1",
  "version": "1.0.0",
  "scope": "persistent_json_safe_actor_snapshot_and_stamina_reducer",
  "runtime": "RUNTIME/actor_simulation_core.py",
  "api": [
    "CentralGameCore.resolve_actor_snapshot",
    "CentralGameCore.validate_actor_snapshot",
    "CentralGameCore.advance_actor_snapshot",
    "CentralGameCore.resolve_actor_behavior_event",
    "CentralGameCore.apply_actor_emotion_effect",
    "ActorSimulationCore.apply_emotion_effect"
  ],
  "source_registries": {
    "employee_metadata": "CHARACTER/EMPLOYEES/employee_metadata.json",
    "employee_metadata_schema": "SCHEMA/CHARACTER/employee_metadata.schema.json",
    "conversation_behavior": "CONTRACTS/conversation_behavior.json",
    "work_seat_lifecycle": "CONTRACTS/work_seat_lifecycle.json",
    "workstation_slot_resolver": "RUNTIME/work_seat_core.py"
  },
  "identity_binding": {
    "actor_id": "employee_id",
    "visual_template_id": "character_id",
    "employee_id_role": "persistent_actor_instance_id",
    "character_id_role": "canonical_visual_template_id",
    "profile_source": "employee_metadata.employees[].stamina_profile",
    "unassigned_policy": "exclude_from_active_snapshot_until_explicit_assignment"
  },
  "snapshot": {
    "runtime_schema": "gds.actor_snapshot.v1",
    "runtime_schema_path": "SCHEMA/actor_snapshot.schema.json",
    "root_required_fields": [
      "schema",
      "version",
      "clock",
      "determinism",
      "actors"
    ],
    "actor_required_fields": [
      "employee_id",
      "character_id",
      "assignment",
      "presence",
      "activity",
      "position",
      "stamina",
      "behavior",
      "conversation_phase",
      "last_event"
    ],
    "assignment_is_authoritative": false,
    "assignment_validation": "resolve_against_employee_metadata_and_runtime_workseat_slot",
    "position_policy": "floor_uv_or_route_reference_when_present; null_while_home",
    "render_policy": "render_action_and_render_owner_are_derived_presentation_outputs",
    "conversation_policy": "actor_route_is_authoritative; stationary_talk_is_a_working_overlay; speech_scheduler_owns_timing",
    "unassigned_actor_policy": "not_eligible_for_runtime_behavior_or_workseat_render"
  },
  "state_vocabulary": {
    "presence": [
      "home",
      "entering",
      "present",
      "leaving"
    ],
    "activity": [
      "walking_to_work",
      "working",
      "talking",
      "wandering",
      "popup_event",
      "going_home",
      "home_recovery",
      "returning_to_work"
    ],
    "threshold_bands": [
      "normal",
      "low",
      "critical"
    ],
    "render_actions": [
      "idle",
      "move",
      "work",
      "happy",
      "sad"
    ],
    "conversation_phase_source": {
      "contract": "CONTRACTS/conversation_behavior.json",
      "field": "actor.conversation_phase",
      "allowed_when_activity": "talking_only_while_route_committed",
      "null_when_activity_is_not_talking": true
    },
    "legal_state_pairs": [
      {
        "presence": "entering",
        "activity": "walking_to_work"
      },
      {
        "presence": "present",
        "activity": "working"
      },
      {
        "presence": "present",
        "activity": "talking"
      },
      {
        "presence": "present",
        "activity": "wandering"
      },
      {
        "presence": "present",
        "activity": "popup_event"
      },
      {
        "presence": "leaving",
        "activity": "going_home"
      },
      {
        "presence": "home",
        "activity": "home_recovery"
      },
      {
        "presence": "entering",
        "activity": "returning_to_work"
      }
    ],
    "legal_transitions": [
      [
        "entering/walking_to_work",
        "present/working"
      ],
      [
        "present/working",
        "present/talking"
      ],
      [
        "present/working",
        "present/wandering"
      ],
      [
        "present/working",
        "present/popup_event"
      ],
      [
        "present/talking",
        "present/working"
      ],
      [
        "present/wandering",
        "present/working"
      ],
      [
        "present/popup_event",
        "present/working"
      ],
      [
        "present/working",
        "leaving/going_home"
      ],
      [
        "leaving/going_home",
        "home/home_recovery"
      ],
      [
        "home/home_recovery",
        "entering/returning_to_work"
      ],
      [
        "entering/returning_to_work",
        "present/working"
      ]
    ]
  },
  "clock": {
    "playback_tick_ms": 60,
    "timestamp_unit": "milliseconds",
    "advance_input": "non_negative_integer_elapsed_ms",
    "tick_remainder_policy": "carry_elapsed_remainder_without_float_rounding",
    "monotonic": true,
    "deterministic_seed_material": [
      "employee_id",
      "profile_seed",
      "event_counter",
      "simulation_time_ms"
    ],
    "event_order": "employee_id_then_event_index"
  },
  "work_presentation_clock": {
    "phase_field": "behavior.work_loop_elapsed_ms",
    "completed_loop_field": "behavior.work_loop_count",
    "phase_policy": "bounded_720ms_normal_work_pose_phase",
    "pc_policy": "NW_NE_advance_one_cell_after_each_completed_normal_work_loop; SE_SW_static_cell0",
    "reset_policy": "reset_both_fields_when_non_talk_working_restarts_after_route_or_mobile_event; preserve_desk_and_talk_overlay_phase"
  },
  "stamina": {
    "storage_unit": "milli_stamina",
    "display_unit": "stamina",
    "display_to_storage_scale": 1000,
    "max_display": 100,
    "max_milli": 100000,
    "initial_display": 100,
    "low_threshold_display": 30,
    "low_threshold_milli": 30000,
    "critical_threshold_display": 10,
    "critical_threshold_milli": 10000,
    "threshold_band_policy": "normal_gt_low; low_lte_low_and_gt_critical; critical_lte_critical",
    "drain_scope": "working_only",
    "drain_profile_source": "employee_metadata.employees[].stamina_profile.work_drain_milli_per_second",
    "drain_range_milli_per_second": [
      600,
      850
    ],
    "drain_remainder_policy": "carry_numerator_remainder_modulo_1000",
    "recovery_operation": "add_then_clamp_to_max",
    "recovery_profile_source": "employee_metadata.stamina_policy.recovery_events",
    "home_trigger": "stamina_lte_critical_threshold",
    "home_restore": "full_on_home",
    "home_delay_source": "employee_metadata.employees[].stamina_profile.home_delay_seconds_range",
    "critical_home_policy": "queue_at_critical_then_finish_current_normal_work_loop",
    "tuning_status": "initial_runtime_tuning_author_review_pending",
    "normal_work_loop_ms": 720,
    "emotion_effect_display_delta": {"sad": -1, "happy": 2},
    "emotion_effect_milli_delta": {"sad": -1000, "happy": 2000}
  },
  "behavior": {
    "weighted_recovery_events": [
      "talk",
      "background_effect",
      "popup",
      "wander"
    ],
    "selection_weights": {
      "talk": 56,
      "background_effect": 25,
      "popup": 19,
      "wander": 0
    },
    "selection_weights_sum": 100,
    "weight_source": "employee_metadata.stamina_policy.recovery_events.*.selection_weight",
    "retired_automatic_events": ["wander"],
    "seat_exit_policy": "only_talk_or_home",
    "cooldown_storage": "absolute_simulation_time_ms",
    "event_counter_scope": "per_actor_and_root",
    "visual_side_effect_policy": "visual_registry_metadata_never_mutates_stamina",
    "visual_selection": {
      "catalog_source": "CHARACTER/EFFECTS/gds_effects_v1.json#effect_order + CHARACTER/EFFECTS/humanball_v1.json#humanball_order",
      "algorithm": "deterministic_per_actor_per_channel_shuffle_bag",
      "state_fields": ["catalog_profile", "generation", "cursor", "active_binding"],
      "automatic_vfx_pool_size": 11,
      "automatic_humanball_pool_size": 6,
      "render_selection_boundary": "behavior_started_event_admission",
      "network_policy": "no_per_event_request",
      "explicit_event_preset_policy": "fixed_mapping_does_not_advance_automatic_bag"
    },
    "threshold_event_policy": "emit_once_per_band_crossing",
    "critical_event_policy": "auto_queue_home_at_critical_then_finish_current_normal_work_loop",
    "talk_session_policy": {
      "request_phase": "talk_pending_with_continuous_work_clock",
      "queue_timeout_ms": 30000,
      "acceptance_command": "start_talk_session",
      "route_ownership": "actor_reducer",
      "route_phases": ["talk_outbound", "talk_hold", "talk_return"],
      "completion_policy": "return_to_owned_workseat_then_complete_recovery_owner_event_without_resetting_work_loop",
      "stationary_participant_policy": "remain_working_at_workseat_and_advance_work_clock_until_shared_return_boundary",
      "stationary_overlay_policy": "no_route_keeps_working_activity; speech_timing_is_overlay; clear_at_shared_return_boundary",
      "endpoint_facing_policy": "start_talk_session.endpoint_facing_overrides_talk_hold_direction_then_return_uses_route_direction",
      "failure_command": "cancel_talk",
      "speech_scheduler_role": "queue_plan_and_timing_only",
      "unavailable_partner_policy": "seated_self_talk_fallback",
      "ceo_request_policy": "seated_self_talk_no_outbound_route"
    }
  },
  "routing": {
    "commands": [
      "start_talk_session",
      "cancel_talk",
      "request_home",
      "request_return"
    ],
    "route_phases": [
      "to_portal",
      "portal_exit",
      "portal_entry",
      "to_workseat",
      "wander_out",
      "wander_back",
      "talk_outbound",
      "talk_hold",
      "talk_return"
    ],
    "portal_fade_steps": 4,
    "home_recovery_policy": "restore_full_stamina_at_portal_exit_then_wait_for_explicit_return",
    "critical_route_policy": "home_requested_event_is_emitted_at_normal_work_loop_boundary",
    "active_event_home_policy": "reject_until_recovery_event_completion",
    "assignment_return_policy": "same_owned_workstation_and_transition_gate"
  },
  "presentation": {
    "event_binding": "behavior_started.presentation",
    "channels": [
      "conversation",
      "vfx",
      "humanball",
      "movement"
    ],
    "pose_policy": "actor_route_owns_motion; stationary_talk_uses_work_clock_with_plan_direction_and_subaction",
    "seat_transition": {
      "field": "actor.position.seat_transition",
      "phases": ["seat_exit", "seat_entry"],
      "anchor_source": "WorkSeatCore",
      "navigation_independent": true,
      "duration_ms": 240,
      "tick_policy": "fixed_60ms_steps",
      "departure_policy": "render_from_seated_foot_anchor_to_existing_transition_gate_before_route_pose_is_visible",
      "arrival_policy": "render_from_existing_transition_gate_to_seated_foot_anchor_before_workseat_owner_is_restored",
      "completion_values": ["to_workseat", "wander_back", "talk_return"]
    },
    "timing_ms": {
      "simulation_tick": 60,
      "character_frame": 360,
      "effect_frame": 240,
      "humanball_frame": 240,
      "normal_work_loop": 720
    }
  },
  "assignment": {
    "source": "employee_metadata.employees[].assignment",
    "slot_id_policy": "runtime_derived_and_validated_not_a_second_registry",
    "ownership_policy": "behavior_never_mutates_assignment",
    "home_policy": "retain_same_owned_workstation",
    "duplicate_character_policy": "reject",
    "duplicate_slot_policy": "reject",
    "cross_floor_policy": "reject",
    "explicit_unassignment_only": true,
    "auto_fill_vacancies": false
  },
  "output": {
    "reducer_input": [
      "json_safe_snapshot",
      "explicit_elapsed_window",
      "explicit_commands_or_events"
    ],
    "reducer_output": [
      "next_snapshot",
      "ordered_events"
    ],
    "storage_owner": "dashboard_or_calling_application",
    "database_or_network": false,
    "hidden_process_state": false,
    "snapshot_round_trip": "json_load_dump_preserves_canonical_values"
  },
  "error_policy": {
    "unknown_schema_or_version": "error",
    "unknown_employee": "error",
    "character_id_mismatch": "error",
    "unassigned_employee": "refuse",
    "duplicate_actor_or_slot": "refuse",
    "assignment_mismatch": "refuse",
    "invalid_state_pair": "error",
    "invalid_transition": "refuse",
    "negative_or_non_integer_clock": "error",
    "stamina_out_of_range": "error",
    "invalid_threshold_band": "error",
    "fallback_guessing": false
  }
}
