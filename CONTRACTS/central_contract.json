      "request_bridge": "behavior_started.actor_request_to_speech_plan",
      "commit_bridge": "speech_session_plan_to_actor_start_talk_session",
      "route_phases": ["talk_outbound", "talk_hold", "talk_return"],
      "completion_bridge": "talk_returned_to_returned_to_work",
      "queue_timeout_ms": 30000,
      "unavailable_partner_fallback": "seated_self_talk",
      "ceo_request_fallback": "seated_self_talk_no_outbound_route"
    },
    "presentation_bridge": {
      "event_source": "behavior_started.presentation",
      "channels": ["conversation", "vfx", "humanball", "movement"],
      "independent_from_stamina": true,
      "emotion_numeric_bridge": {"owner": "CentralGameCore.actor_snapshot", "sad": -1, "happy": 2}
    }
  },
  "speech_scheduler": {
    "contract": "CONTRACTS/speech_scheduler.json",
    "schema": "SCHEMA/speech_scheduler.schema.json",
    "snapshot_schema": "SCHEMA/speech_scheduler_snapshot.schema.json",
