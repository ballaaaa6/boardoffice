    "timing_policy": "solo_30_60s_pair_45_75s_greeting_2_3s_bubble_4000ms_fade_300ms",
    "lane_policy": "one_speech_lane_per_floor_until_fade_end",
    "pose_policy": "speech_selects_timing_and_actor_commits_pose_route",
