      "CentralGameCore.resolve_speech_snapshot",
      "CentralGameCore.validate_speech_snapshot",
      "CentralGameCore.advance_speech_snapshot"
    ],
    "categories": {
      "solo_recurring": ["encouragement", "uncertainty", "surprise", "work_progress", "idle_flavor"],
      "pair_exchange": ["conversation_open", "conversation_reply"],
      "lifecycle_one_shot": ["greeting", "work_start", "fatigue", "leaving"]
