{
  "$schema": "gds.speech_scheduler.v1",
  "schema": "gds.speech_scheduler.v1",
  "contract_id": "contract.gds.speech_scheduler.v1",
  "version": "1.0.0",
  "scope": "deterministic_speech_lane_and_conversation_trigger_scheduler",
  "runtime": "RUNTIME/speech_scheduler_core.py",
  "api": [
    "CentralGameCore.resolve_speech_snapshot",
    "CentralGameCore.validate_speech_snapshot",
    "CentralGameCore.advance_speech_snapshot"
  ],
  "categories": {
    "in_work_rotation": [
      "anticipation",
      "work_progress",
      "work_complete",
      "encouragement",
      "praise",
      "celebration",
      "disappointment",
      "fatigue",
      "surprise",
      "uncertainty",
      "idle_flavor"
    ],
    "solo_recurring": [
      "anticipation",
      "work_progress",
      "work_complete",
      "encouragement",
      "praise",
      "celebration",
      "disappointment",
      "fatigue",
      "surprise",
      "uncertainty",
      "idle_flavor"
    ],
    "pair_exchange": [
      "conversation_open",
      "conversation_reply"
    ],
    "lifecycle_one_shot": {
      "greeting": {
        "trigger": "spawn_then_delay",
        "delay_seconds_range": [2, 3],
        "once_per_spawn": true
      },
      "work_start": {
        "trigger": "workseat_entered",
        "once_per_work_session": true
      },
      "leaving": {
        "trigger": "rendered_actor_draws_over_reception",
        "once_per_departure": true
      }
    },
    "legacy_compatibility": {
      "fatigue": "explicit_home_request_only"
    }
  },
  "work_dialogue_policy": {
    "trigger": "actor_activity_working",
    "categories": [
      "anticipation",
      "work_progress",
      "work_complete",
      "encouragement",
      "praise",
      "celebration",
      "disappointment",
      "fatigue",
      "surprise",
      "uncertainty",
      "idle_flavor"
    ],
    "selection": "persistent_shuffle_bag_no_repeat_then_refill",
    "bubble_selection": "smallest_allowed_fit",
    "pose_policy": "remain_seated_at_owned_workseat",
    "numeric_effect_policy": "none"
  },
  "timing": {
    "playback_tick_ms": 60,
    "bubble_visible_ms": 4000,
    "bubble_fade_ms": 300,
    "session_hold_ms": 4300,
    "solo_interval_seconds_range": [30, 60],
    "pair_interval_seconds_range": [45, 75],
    "retry_interval_seconds_range": [15, 30],
    "timer_semantics": "work_time_only_reset_after_return_to_work",
    "first_bubble_boundary": "conversation_talk_arrival",
    "no_overlap_scope": "one_speech_lane_per_floor",
    "same_session_pair_bubbles_may_overlap": true
  },
  "conversation_modes": {
    "selection": "uniform_among_currently_valid_modes",
    "available_modes": ["ceo_front", "seated_host", "standing_pair"],
    "ceo_front": {
      "initiator": "employee",
      "partner": "same_floor_ceo",
      "visitor_pose": "idle",
      "host_pose": "normal_work",
      "host_movement": "none"
    },
    "seated_host": {
      "initiator": "employee",
      "partner": "same_floor_employee",
      "visitor_pose": "idle",
      "host_pose": "turn_side_target_direction",
      "host_movement": "none"
    },
    "standing_pair": {
      "initiator": "employee",
      "partner": "same_floor_employee",
      "visitor_pose": "idle",
      "host_pose": "idle",
      "host_movement": "walk_to_talk_spot"
    },
    "ceo_outbound": false,
    "unavailable_partner_fallback": "seated_self_talk",
    "ceo_request_fallback": "seated_self_talk_no_outbound_route",
    "cross_floor": false,
    "group_talk": false,
    "walk_and_talk": false
  },
  "emotion": {
    "standing_pair_only": true,
    "roll_scope": "one_shared_roll_per_completed_standing_pair",
    "even_result": "happy",
    "odd_result": "sad",
    "hold_ms": 1200,
    "stamina_effect": "actor_snapshot_numeric_delta",
    "stamina_effect_display_delta": {"sad": -1, "happy": 2},
    "stamina_effect_milli_delta": {"sad": -1000, "happy": 2000},
    "stamina_effect_owner": "CentralGameCore.actor_snapshot",
    "return_after_emotion": true
  },
  "lane": {
    "scope": "floor",
    "lock_window": "first_bubble_until_fade_end",
    "queue_policy": "priority_then_due_time_then_employee_id",
    "priority_order": ["leaving", "fatigue", "pair", "greeting", "work_start", "solo"]
  },
  "actor_bridge": {
    "talk_behavior": "behavior_started.actor_request_to_speech_plan",
    "talk_commit": "speech_session_plan_to_actor_start_talk_session",
    "reception_crossing": "actor_route_sample_draws_over_reception",
    "workseat_reentry": "workseat_reentered_to_returned_to_work",
    "effective_timestamp_field": "effective_at_ms",
    "unavailable_partner_fallback": "seated_self_talk",
    "ceo_request_fallback": "seated_self_talk_no_outbound_route"
  },
  "assignment_policy": "scheduler_never_mutates_workstation_ownership",
  "render_policy": "speech_selects_timing_and_actor_commits_pose_route",
  "leaving_trigger_source": "CentralGameCore.actor_draws_over_reception"
}
